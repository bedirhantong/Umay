<?xml version="1.0" encoding="utf-8"?>
<!-- Building maps are worth backing up (a survey takes real legwork to redo);
     field-test logs are large, disposable, and already shared off-device on
     purpose, so they're kept out of cloud backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="field-logs/" />
        <exclude domain="file" path="crash-logs/" />
        <exclude domain="file" path="survey-draft/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="field-logs/" />
        <exclude domain="file" path="crash-logs/" />
        <exclude domain="file" path="survey-draft/" />
    </device-transfer>
</data-extraction-rules>
