<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Lets Android Studio's profiler and Perfetto record this release-like build
             without making it debuggable (which would slow it down again). -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>
</manifest>
